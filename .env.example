# ============ SERVER CONFIGURATION ============
PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_key_change_this_12345

# ============ DATABASE ============
# Used by docker-compose to create the Postgres container
POSTGRES_DB=hotspot_db
POSTGRES_USER=hotspot
POSTGRES_PASSWORD=change_this_strong_password

# Used by the Node app to connect (docker-compose overrides the host to 'postgres')
DATABASE_URL=postgresql://hotspot:change_this_strong_password@localhost:5432/hotspot_db

# ============ M-PESA CONFIGURATION ============
# Get these from https://developer.safaricom.co.ke

# Sandbox environment for testing
MPESA_ENV=sandbox
# MPESA_ENV=production  # Use this when going live

# Your M-Pesa API Credentials
MPESA_CONSUMER_KEY=your_consumer_key_from_safaricom
MPESA_CONSUMER_SECRET=your_consumer_secret_from_safaricom

# Your Business/Paybill Number
MPESA_BUSINESS_SHORTCODE=174379

# Get this from Safaricom Support
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd1a503b6e

# Your server callback URL (for M-Pesa payment confirmations)
CALLBACK_URL=https://yourdomain.com

# Comma-separated IPs/CIDRs allowed to POST /mpesa/callback.
# Use Safaricom's published M-Pesa ranges, e.g. 196.201.214.0/24,196.201.213.0/24
# Leave empty to allow all sources (fine for development, not production).
MPESA_CALLBACK_IPS=

# Set to true to simulate the FULL M-Pesa flow without Safaricom credentials:
# STK push instantly "succeeds" and a fake callback auto-confirms ~8s later,
# exercising the real DB credit + WiFi provisioning logic. Great for dev/demo.
MOCK_MPESA=false

# ============ MIKROTIK CONFIGURATION ============
# Your Mikrotik Access Point Details
MIKROTIK_HOST=192.168.1.1
MIKROTIK_USER=admin
MIKROTIK_PASS=your_mikrotik_password

# Mikrotik RADIUS port (if using RADIUS authentication)
MIKROTIK_RADIUS_PORT=3799

# ============ PORTAL SETTINGS ============
# Portal branding
PORTAL_NAME=MyWiFi Hotspot
PORTAL_LOGO=https://yourdomain.com/logo.png

# Min and max WiFi session hours
MIN_SESSION_HOURS=1
MAX_SESSION_HOURS=168

# ============ NOTIFICATION SETTINGS ============
# SMS Notifications (optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# Email Notifications (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your_app_password

# ============ MONITORING & LOGGING ============
LOG_LEVEL=info
LOG_FILE=/var/log/hotspot/server.log

# ============ SECURITY ============
# CORS allowed origins
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Admin API key — required for /admin/stats and other admin endpoints
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=change_this_to_a_strong_random_secret

# Session timeout (minutes)
SESSION_TIMEOUT=1440

# Account balance auto-deduction (true/false)
AUTO_DEDUCT_BALANCE=true

# ============ DEVELOPMENT ONLY ============
DEBUG=false

# ============ CREDENTIAL ENCRYPTION ============
# Key used to AES-256-GCM encrypt Mikrotik WiFi passwords at rest in the DB.
# Generate with: openssl rand -hex 32
# Falls back to JWT_SECRET if unset (not recommended for production).
CREDENTIALS_ENCRYPTION_KEY=
